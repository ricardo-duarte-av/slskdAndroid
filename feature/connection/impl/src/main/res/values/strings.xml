<resources>

    <string name="connection_title">Connect to slskd</string>
    <string name="connection_section_server">Server</string>
    <string name="connection_intro">Enter the address of your slskd instance and an API key. Both are required — the app authenticates with the API key.</string>

    <string name="connection_base_url_label">Base URL</string>
    <!-- Example address only; not a real host. Kept translatable so locales can use a
         region-appropriate example if they prefer. -->
    <string name="connection_base_url_placeholder">http://192.168.1.10:5030</string>
    <string name="connection_api_key_label">API key</string>

    <string name="connection_connect">Connect</string>
    <string name="connection_connecting">Connecting…</string>

    <!-- Shown when the connection attempt failed and slskd gave us no message of its own. -->
    <string name="connection_error_fallback">Could not connect to slskd</string>

    <!-- Connection failures, mapped from ConnectionFailure so they can be translated. -->
    <string name="connection_error_invalid_url">That doesn\'t look like a valid address. Include http:// or https://.</string>
    <string name="connection_error_auth">Authentication failed — check the API key.</string>
    <string name="connection_error_http">slskd returned HTTP %1$d.</string>
    <string name="connection_error_unreachable">Couldn\'t reach slskd at that address. Check the host and port.</string>

